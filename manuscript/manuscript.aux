\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces  Computational cost of the two-stage solver for different regularization scales. The shifted denominator $r_\varepsilon (\rho )=\rho +\varepsilon $ is used in all cases, with the same initialization, Fourier resolution $N=4096$, and solver parameters. ``FISTA'' and ``Newton'' denote the iteration counts in the two stages, and ``PCG'' is the accumulated number of inner PCG iterations. The last column reports the final projected-gradient residual $\|\mathcal  G_{\tau _r}(\rho )\|_h$ \eqref  {eq:pg-map}. The asterisk indicates that the FISTA stage reached the prescribed iteration limit. }}{18}{table.5.3}\protected@file@percent }
\newlabel{tab:solver-regularization-cost}{{5.3}{18}{Computational cost of the two-stage solver for different regularization scales. The shifted denominator $r_\eps (\rho )=\rho +\eps $ is used in all cases, with the same initialization, Fourier resolution $N=4096$, and solver parameters. ``FISTA'' and ``Newton'' denote the iteration counts in the two stages, and ``PCG'' is the accumulated number of inner PCG iterations. The last column reports the final projected-gradient residual $\|\mathcal G_{\tau _r}(\rho )\|_h$ \eqref {eq:pg-map}. The asterisk indicates that the FISTA stage reached the prescribed iteration limit}{table.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces  Two-dimensional ground-state densities computed on $[-16,16]^2$ with $N_x=N_y=512$, with the central region shown. The left panel corresponds to the anisotropic harmonic trap \eqref  {eq:2d-anisotropic-harmonic}, while the right panel includes the square optical lattice \eqref  {eq:2d-optical-lattice}. Both computations use $\varepsilon =10^{-2}$, $\sigma =10^{-4}$, and $\beta =\delta =10$. }}{18}{figure.5.6}\protected@file@percent }
\newlabel{fig:two-dimensional-examples}{{5.6}{18}{Two-dimensional ground-state densities computed on $[-16,16]^2$ with $N_x=N_y=512$, with the central region shown. The left panel corresponds to the anisotropic harmonic trap \eqref {eq:2d-anisotropic-harmonic}, while the right panel includes the square optical lattice \eqref {eq:2d-optical-lattice}. Both computations use $\eps =10^{-2}$, $\sig =10^{-4}$, and $\beta =\delta =10$}{figure.5.6}{}}
