\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces  Effect of the kinetic regularization. The shifted and piecewise $C^1/C^2$ denominators are compared using the same potential regularization, Fourier resolution, and reference state. The left panel shows the $L^2$ state error and the right panel shows the energy error evaluated with the common unregularized kinetic denominator $r_0(s)=s$. The dashed and dotted lines indicate first- and second-order slopes, respectively. }}{16}{figure.5.4}\protected@file@percent }
\newlabel{fig:kinetic-regularization}{{5.4}{16}{Effect of the kinetic regularization. The shifted and piecewise $C^1/C^2$ denominators are compared using the same potential regularization, Fourier resolution, and reference state. The left panel shows the $L^2$ state error and the right panel shows the energy error evaluated with the common unregularized kinetic denominator $r_0(s)=s$. The dashed and dotted lines indicate first- and second-order slopes, respectively}{figure.5.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Dependence on the regularization scales.}{16}{section*.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces  Convergence histories for continued FISTA and the two-stage FISTA--Newton strategy with $\varepsilon =10^{-2}$, $\sigma =10^{-4}$, $L=32$, and $N=4096$. The left panel shows the energy error relative to the final two-stage solution, and the right panel shows the projected-gradient residual. The two curves share exactly the same FISTA history up to the marker, which denotes the switch to the Newton--PCG refinement; thereafter one branch continues FISTA and the other uses Newton--PCG. }}{17}{figure.5.5}\protected@file@percent }
\newlabel{fig:solver-performance}{{5.5}{17}{Convergence histories for continued FISTA and the two-stage FISTA--Newton strategy with $\eps =10^{-2}$, $\sig =10^{-4}$, $L=32$, and $N=4096$. The left panel shows the energy error relative to the final two-stage solution, and the right panel shows the projected-gradient residual. The two curves share exactly the same FISTA history up to the marker, which denotes the switch to the Newton--PCG refinement; thereafter one branch continues FISTA and the other uses Newton--PCG}{figure.5.5}{}}
