\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces  Convergence histories for continued FISTA and the two-stage FISTA--Newton method with $\varepsilon =10^{-2}$, $\sigma =10^{-4}$, $L=32$, and $N=4096$. The left panel shows the energy error relative to the final two-stage solution, and the right panel shows the projected-gradient residual $\left \|\mathcal  G_1(\rho ^k)\right \|_h$. Here ``potential-proximal FISTA'' and ``smooth-potential FISTA'' refer to placing the regularized potential in the proximal and smooth parts of the splitting, respectively. }}{17}{figure.5.5}\protected@file@percent }
\newlabel{fig:solver-performance}{{5.5}{17}{Convergence histories for continued FISTA and the two-stage FISTA--Newton method with $\eps =10^{-2}$, $\sig =10^{-4}$, $L=32$, and $N=4096$. The left panel shows the energy error relative to the final two-stage solution, and the right panel shows the projected-gradient residual $\norm {\mathcal G_1(\rho ^k)}_h$. Here ``potential-proximal FISTA'' and ``smooth-potential FISTA'' refer to placing the regularized potential in the proximal and smooth parts of the splitting, respectively}{figure.5.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Dependence on the regularization scales.}{17}{section*.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces  Computational cost of the two-stage solver for different regularization scales with $r_\varepsilon (\rho )=\rho +\varepsilon $ and $N=4096$. ``FISTA'' and ``Newton'' denote the iteration counts in the two stages, and the last column reports the final projected-gradient residual $\|\mathcal  G_1(\rho )\|_h$ \eqref  {eq:pg-map}. The asterisk marks a run that reached the FISTA iteration limit. }}{17}{table.5.3}\protected@file@percent }
\newlabel{tab:solver-regularization-cost}{{5.3}{17}{Computational cost of the two-stage solver for different regularization scales with $r_\eps (\rho )=\rho +\eps $ and $N=4096$. ``FISTA'' and ``Newton'' denote the iteration counts in the two stages, and the last column reports the final projected-gradient residual $\|\mathcal G_1(\rho )\|_h$ \eqref {eq:pg-map}. The asterisk marks a run that reached the FISTA iteration limit}{table.5.3}{}}
